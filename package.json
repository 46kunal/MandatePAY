{
  "name": "mandatepay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Intent-backed agent purchases and fair dispute resolution on PayPal",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "eval": "tsx --env-file=.env eval/run.ts"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.6.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "^16.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
