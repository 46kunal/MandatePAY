# Copy to .env and fill in. Never commit .env.

# --- Database (local Docker Postgres from docker-compose.yml) ---
# Host port is 5434 to avoid clashes with other local Postgres instances.
DATABASE_URL=postgres://mandatepay:mandatepay@localhost:5434/mandatepay

# --- PayPal sandbox (see docs/PAYPAL_SANDBOX_SETUP.md) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID; exposed to the browser for the PayPal buyer button
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox only. The app refuses to start against any other PayPal host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID PayPal assigns when you register your ngrok URL (optional: polling works without it)
PAYPAL_WEBHOOK_ID=

# --- App ---
APP_BASE_URL=http://localhost:3000
# Orders above this amount wait for a human click (buyer approval / merchant approval)
APPROVAL_THRESHOLD=100.00
# Where the mandate signing keys are stored (gitignored)
KEY_DIR=.keys

# --- LLM: LLM_PROVIDER = mock (default, no key) | gemini | anthropic ---
# gemini: key from https://aistudio.google.com/apikey, LLM_MODEL defaults to gemini-2.5-flash
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
