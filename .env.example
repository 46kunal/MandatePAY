# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local: the Docker Postgres from docker-compose.yml (host port 5434 avoids clashes).
# Hosted (Vercel): Neon's *pooled* connection string, e.g. postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgres://mandatepay:mandatepay@localhost:5434/mandatepay
# Optional: connections per server instance (default 10 locally, 3 on Vercel)
DB_POOL_MAX=

# --- PayPal sandbox (see docs/PAYPAL_SANDBOX_SETUP.md) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID; exposed to the browser for the PayPal buyer button
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox only. The app refuses to start against any other PayPal host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from `npx tsx scripts/paypal-webhook.ts register <public-url>` (optional: polling works without it).
# One per environment: local tunnel, preview and production each register their own URL.
PAYPAL_WEBHOOK_ID=

# --- App ---
APP_BASE_URL=http://localhost:3000
# Defaults only: once the owner saves Settings > Store and rules in the app, the saved values win.
APPROVAL_THRESHOLD=100.00
MERCHANT_NAME=

# --- Sign-in (Better Auth) ---
# Signs session cookies. Required on Vercel; use a different random value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Optional: the public URL sign-in runs on. Defaults to APP_BASE_URL.
BETTER_AUTH_URL=

# --- Mandate signing keys ---
# Local and Docker: keys are files in KEY_DIR (gitignored), created on first use.
KEY_DIR=.keys
# Hosted (Vercel has no lasting disk): set both, from `npm run keys:export` (writes .keys/hosting.env). Secret.
MANDATE_BUYER_PRIVATE_KEY=
MANDATE_AGENT_PRIVATE_KEY=

# --- LLM (required): LLM_PROVIDER = gemini | grok | anthropic ---
# Drafting mandates, the shopping agent, fuzzy matching and dispute analysis all use it. There is no offline fallback.
# gemini: key from https://aistudio.google.com/apikey, LLM_MODEL defaults to gemini-3.1-flash-lite
# grok: key from https://console.x.ai. Run `npx tsx scripts/llm-models.ts` to see which LLM_MODEL your key can use.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Gemini only: second model tried once on a timeout, overload (503) or rate limit (429). Empty = gemini-3-flash-preview.
LLM_FALLBACK_MODEL=
